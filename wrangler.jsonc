{
  "name": "fundblick-development",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node development/build-cloudflare-preview.js"
  },
  "previews": {},
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
